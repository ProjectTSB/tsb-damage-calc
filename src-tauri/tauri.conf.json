{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSB Damage Calc",
  "version": "0.1.0",
  "identifier": "dev.tsb.damage-calc",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TSB ダメージ計算",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
